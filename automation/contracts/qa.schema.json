{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantterminal.local/automation/contracts/qa.schema.json",
  "title": "QA to Review Message",
  "description": "Validation summary emitted by QA Agent and consumed by Review Agent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tsc",
    "tests",
    "audits",
    "warnings",
    "failures"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "tsc": {
      "$ref": "#/$defs/checkResult"
    },
    "tests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/checkResult"
      }
    },
    "audits": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/checkResult"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "checkResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "summary"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "skipped",
            "blocked"
          ]
        },
        "command": {
          "type": [
            "string",
            "null"
          ]
        },
        "summary": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    }
  }
}
