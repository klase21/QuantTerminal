{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantterminal.local/automation/contracts/task.schema.json",
  "title": "Planner to Codex Task Message",
  "description": "Task message emitted by the Planner Agent and consumed by Codex Worker.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "sprint",
    "title",
    "goal",
    "scope",
    "constraints",
    "files",
    "validation",
    "expected_output"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "sprint": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "validation": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "expected_output": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
